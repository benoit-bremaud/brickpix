{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brickpix",
  "compatibility_date": "2026-10-19",
  // Static site: the built `dist` folder is served as Worker assets, no Worker script.
  "assets": {
    "directory": "./dist",
    // The future editor may use client-side routes; unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  },
  // Uploaded versions get a URL: the version alias "staging" of `just deploy staging` (ADR-0001).
  "preview_urls": true
}
